---
import { tempoLabel, type Tempo } from "../lib/tempo";

interface Props {
  tempo: Tempo;
  timeToStart: string;
  duration?: string;
}

const { tempo, timeToStart, duration } = Astro.props;
---

<span class="tempo-pill">{tempoLabel(tempo)}</span>
<span class="commitment">Start: {timeToStart}{duration && <> · {duration}</>}</span>
