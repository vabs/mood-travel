---
interface PreviewResource {
  title: string;
  type: string;
}

interface Props {
  journeyId: string;
  name: string;
  rationale: string;
  manageableFeelings: string[];
  availableTypes: string[];
  availableTempos: string[];
  preview: PreviewResource[];
}

const { journeyId, name, rationale, manageableFeelings, availableTypes, availableTempos, preview } = Astro.props;
---

<li
  class="route-card"
  data-manageable-feelings={manageableFeelings.join(" ")}
  data-types={availableTypes.join(" ")}
  data-tempos={availableTempos.join(" ")}
>
  <h3><a href={`/journey/${journeyId}/`}>{name}</a></h3>
  <p class="rationale">{rationale}</p>
  {
    preview.length > 0 && (
      <p class="preview">
        Includes {preview.map((p) => `${p.title} (${p.type})`).join(", ")}
        {preview.length === 1 ? "" : ", and more"}.
      </p>
    )
  }
</li>
